#include <iostream>
using namespace std;
class stack{
    int *arr;
    int size;
    int top;
    public:
    stack(int s){
        size = s;
        top = -1;
        arr = new int[s];
    }
    // push operation 
    void push(int value){
        if (top == size - 1){
            cout<<"stack overflow\n";

        }
        else {
            top++;
            arr[top] = value;
        }
    }
        // pop operation
        void pop(){
            if (top == -1){
                cout<<"stack underflow\n";
            }
            else{
                top--;
                cout<<"popped element is:"<<arr[top+1]<<endl;

            }
        }
        // peek operation
        int peek(){
            if (top == -1){
                cout<<"stack empty\n";
                return -1;
            }
            else{
                return arr[top];
            }

        }
        //is empty operation
        bool isEmpty(){
            return top == -1;

        }
        //issize operation
        int IsSize(){
            return top + 1;

        }
};
int main(){
    stack S[5];
    S.push(10);
    S.push(9);
    S.push(8);
    S.pop();
}
